# macOS / 编辑器
.DS_Store
.AppleDouble
*.swp
*~

# 本地构建产物（体积大，不进版本库）
dist/*.dmg
dist/*.pkg
dist/_旧构建残留/
# 旧版说明书 PDF 不入库；只保留当前版本那份，保证 clone 后能打包出完整 App
docs/*.pdf
