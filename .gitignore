build/
*.app/

# WorkBuddy 本地工作记忆（不属于开源发布内容）
.workbuddy-ai/

# 说明书 PDF 渲染工具的中间产物
/tmp/

# 运行时配置备份（App 检测到外部修改时自动生成）
drives.json.external-*
